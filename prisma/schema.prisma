generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
}

enum UniversityStatus {
  ACTIVE
  INACTIVE
}

enum ProgrammeLevel {
  CERTIFICATE
  DIPLOMA
  BACHELOR
  MASTERS
  DOCTORATE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
  WITHDRAWN
}

enum AcademicMateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MateOfferingStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MateRequestStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum TutoringArrangementType {
  ONE_TIME
  RECURRING
}

enum TutoringArrangementStatus {
  PENDING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  // A one-time arrangement whose session went 24h past its end with no response from anyone.
  EXPIRED
}

enum TutoringSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  DISPUTED
}

enum AttendanceStatus {
  PENDING
  STUDENT_CHECKED_IN
  CONFIRMED
  DISPUTED
  EXCUSED
}

enum RescheduleRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum StudentCourseStatus {
  ENROLLED
  COMPLETED
  DROPPED
  REPEATING
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum NotificationType {
  SYSTEM
  MATE_REQUEST
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  SESSION_SCHEDULED
  SESSION_REMINDER
  SESSION_COMPLETED
  SESSION_CANCELLED
  NEW_MESSAGE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYOUT_COMPLETED
  REVIEW_RECEIVED
  VERIFICATION_UPDATED
  SUBSCRIPTION_UPDATED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum PaymentProvider {
  MTN_ZAMBIA
  AIRTEL_ZAMBIA
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportCasePriority {
  LOW
  NORMAL
  HIGH
}

enum SupportCaseCategory {
  ACCOUNT
  TUTORING
  CONDUCT
  TECHNICAL
  OTHER
}

enum AdminRole {
  PLATFORM_ADMIN
  UNIVERSITY_ADMIN
  MODERATOR
  SUPPORT
}

model User {
  id                            String                     @id
  name                          String
  email                         String                     @unique
  emailVerified                 Boolean
  image                         String?
  createdAt                     DateTime
  updatedAt                     DateTime
  username                      String?                    @unique
  anonymisedAt                  DateTime?
  supportCasesAbout             SupportCase[]              @relation("SupportCaseSubject")
  sessions                      Session[]
  accounts                      Account[]
  studentProfile                StudentProfile?            @relation("UserStudentProfile")
  academicMate                  AcademicMateProfile?       @relation("UserAcademicMateProfile")
  adminProfile                  AdminProfile?              @relation("UserAdminProfile")
  notifications                 Notification[]             @relation("UserNotifications")
  sentMessages                  Message[]                  @relation("UserSentMessages")
  conversationReads             ConversationRead[]
  reviewsWritten                Review[]                   @relation("UserReviewsWritten")
  paymentsMade                  Payment[]                  @relation("UserPaymentsMade")
  subscriptions                 UserSubscription[]
  rescheduleRequestsProposed    SessionRescheduleRequest[] @relation("RescheduleProposer")
  rescheduleRequestsReceived    SessionRescheduleRequest[] @relation("RescheduleResponder")
  tutoringArrangementsCancelled MateRequest[]              @relation("TutoringArrangementCancelledBy")
  tutoringSessionsCancelled     TutoringSession[]          @relation("SessionCancelledBy")
  disputedSessionCompletions     TutoringSession[]           @relation("SessionCompletionDisputedBy")
  pushSubscriptions             PushSubscription[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminMfa  AdminSessionMfa?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// Verification and change-email links that have been opened. Only a hash is kept, so each link works once.
model UsedEmailToken {
  tokenHash String   @id
  usedAt    DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model University {
  id                   String                  @id @default(uuid())
  code                 String                  @unique
  name                 String
  slug                 String                  @unique
  status               UniversityStatus        @default(ACTIVE)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  settings             UniversitySettings?
  schools              School[]
  programmes           Programme[]
  academicYears        AcademicYear[]
  courses              Course[]
  studentProfiles      StudentProfile[]
  academicMateProfiles AcademicMateProfile[]
  mateOfferings        MateOffering[]
  mateRequests         MateRequest[]
  adminAccess          AdminUniversityAccess[]
  supportCases         SupportCase[]
}

model UniversitySettings {
  id                     String     @id @default(uuid())
  universityId           String     @unique
  studentIdMinLength     Int        @default(1)
  studentIdMaxLength     Int        @default(50)
  studentIdPrefix        String?
  studentIdPattern       String?
  requireUniversityEmail Boolean    @default(false)
  universityEmailDomain  String?
  timezone               String     @default("Africa/Lusaka")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  university             University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model School {
  id           String       @id @default(uuid())
  universityId String
  code         String
  name         String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  university   University   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programmes   Programme[]
  departments  Department[]

  @@unique([universityId, code])
  @@unique([id, universityId])
  @@index([universityId])
}

model Department {
  id        String   @id @default(uuid())
  schoolId  String
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programmes Programme[]

  @@unique([schoolId, code])
  @@unique([id, schoolId])
  @@index([schoolId])
}

model Programme {
  id              String           @id @default(uuid())
  universityId    String
  schoolId        String
  departmentId    String?
  code            String
  name            String
  level           ProgrammeLevel   @default(BACHELOR)
  durationYears   Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  university      University       @relation(fields: [universityId], references: [id], onDelete: Restrict)
  school          School           @relation(fields: [schoolId, universityId], references: [id, universityId], onDelete: Cascade)
  department      Department?      @relation(fields: [departmentId, schoolId], references: [id, schoolId], onDelete: NoAction)
  years           ProgrammeYear[]
  studentProfiles StudentProfile[]

  @@unique([universityId, code])
  @@unique([id, universityId])
  @@index([universityId, schoolId])
}

model ProgrammeYear {
  id               String                   @id @default(uuid())
  programmeId      String
  yearNumber       Int
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  programme        Programme                @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  programmeCourses ProgrammeCourse[]
  electiveGroups   ProgrammeElectiveGroup[]
  studentProfiles  StudentProfile[]

  @@unique([programmeId, yearNumber])
  @@unique([id, programmeId])
  @@index([programmeId])
}

model AcademicYear {
  id             String          @id @default(uuid())
  universityId   String
  name           String
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  university     University      @relation(fields: [universityId], references: [id], onDelete: Restrict)
  studentCourses StudentCourse[]

  @@unique([universityId, name])
  @@index([universityId, isCurrent])
}

model Course {
  id               String            @id @default(uuid())
  universityId     String
  code             String
  name             String
  description      String?
  credits          Decimal?          @db.Decimal(5, 2)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  university       University        @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programmeCourses ProgrammeCourse[]
  studentCourses   StudentCourse[]
  mateOfferings    MateOffering[]
  topics           CourseTopic[]

  @@unique([universityId, code])
  @@unique([id, universityId])
  @@index([universityId, code])
  @@index([universityId, name])
}

model ProgrammeCourse {
  id              String                  @id @default(uuid())
  programmeYearId String
  courseId        String
  semester        Int?
  isCompulsory    Boolean                 @default(true)
  electiveGroupId String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  programmeYear   ProgrammeYear           @relation(fields: [programmeYearId], references: [id], onDelete: Cascade)
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)
  electiveGroup   ProgrammeElectiveGroup? @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)

  @@unique([programmeYearId, courseId])
  @@index([courseId])
  @@index([electiveGroupId])
}

model ProgrammeElectiveGroup {
  id               String            @id @default(uuid())
  programmeYearId  String
  name             String
  minSelections    Int               @default(1)
  maxSelections    Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  programmeYear    ProgrammeYear     @relation(fields: [programmeYearId], references: [id], onDelete: Cascade)
  programmeCourses ProgrammeCourse[]

  @@unique([programmeYearId, name])
  @@index([programmeYearId])
}

model StudentProfile {
  id                String               @id @default(uuid())
  userId            String               @unique
  universityId      String
  studentId         String
  gender            Gender
  programmeId       String
  programmeYearId   String
  status            StudentStatus        @default(ACTIVE)
  phoneNumber       String?              @unique
  bio               String?
  profileVisibility ProfileVisibility    @default(PUBLIC)
  showStudentId     Boolean              @default(false)
  showPhoneNumber   Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation("UserStudentProfile", fields: [userId], references: [id], onDelete: Cascade)
  university        University           @relation(fields: [universityId], references: [id], onDelete: Restrict)
  programme         Programme            @relation(fields: [programmeId, universityId], references: [id, universityId], onDelete: Restrict)
  programmeYear     ProgrammeYear        @relation(fields: [programmeYearId, programmeId], references: [id, programmeId], onDelete: Restrict)
  courses           StudentCourse[]
  requests          MateRequest[]
  academicMate      AcademicMateProfile? @relation("StudentProfileAcademicMate")

  @@unique([universityId, studentId])
  @@unique([id, universityId])
  @@index([universityId, programmeId, programmeYearId])
  @@index([programmeId])
}

model StudentCourse {
  id               String              @id @default(uuid())
  studentProfileId String
  courseId         String
  academicYearId   String
  semester         Int?
  status           StudentCourseStatus @default(ENROLLED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  studentProfile   StudentProfile      @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  academicYear     AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, courseId, academicYearId])
  @@index([courseId])
  @@index([academicYearId])
}

model CourseTopic {
  id             String              @id @default(uuid())
  courseId       String
  name           String
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offeringTopics MateOfferingTopic[]

  @@unique([courseId, name])
  @@index([name])
}

model AcademicMateProfile {
  id                  String                      @id @default(uuid())
  userId              String                      @unique
  universityId        String
  studentProfileId    String?                     @unique
  status              AcademicMateStatus          @default(ACTIVE)
  verificationStatus  VerificationStatus          @default(UNVERIFIED)
  headline            String?
  bio                 String?
  teachingExperience  String?
  yearsExperience     Int?
  profileVisibility   ProfileVisibility           @default(PUBLIC)
  verifiedAt          DateTime?
  verifiedByAdminId   String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  user                User                        @relation("UserAcademicMateProfile", fields: [userId], references: [id], onDelete: Cascade)
  university          University                  @relation(fields: [universityId], references: [id], onDelete: Restrict)
  studentProfile      StudentProfile?             @relation("StudentProfileAcademicMate", fields: [studentProfileId], references: [id], onDelete: SetNull)
  verifiedByAdmin     AdminProfile?               @relation("AdminVerifiedAcademicMates", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  offerings           MateOffering[]
  availabilities      MateAvailability[]
  experiences         AcademicMateExperience[]
  qualifications      AcademicMateQualification[]
  reviews             Review[]                    @relation("ReviewsReceived")
  verificationHistory AcademicMateVerification[]
  evidence            AcademicMateEvidence[]
  payments            Payment[]
  payouts             Payout[]

  @@unique([id, universityId])
  @@index([universityId, status])
  @@index([universityId, verificationStatus])
}

enum EvidenceKind {
  STUDENT_ID
  NATIONAL_ID
  PASSPORT
  PROOF_OF_ENROLMENT
  ACADEMIC_RESULTS
}

enum EvidenceReview {
  PENDING
  ACCEPTED
  REJECTED
}

/// A private document (student ID, proof of enrolment, results) uploaded to prove an Academic Mate's identity.
/// The file lives in private storage under storageKey and is only ever opened through short-lived admin links.
model AcademicMateEvidence {
  id                    String         @id @default(uuid())
  academicMateProfileId String
  kind                  EvidenceKind
  storageKey            String         @unique
  contentType           String
  sizeBytes             Int
  sha256                String
  reviewStatus          EvidenceReview @default(PENDING)
  rejectionReason       String?
  reviewedByAdminId     String?
  reviewedAt            DateTime?
  /// Set when the file was included in a verification request.
  submittedAt           DateTime?
  /// After this date the clean-up script deletes the file and this row.
  purgeAfter            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  academicMateProfile AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Cascade)
  reviewedByAdmin     AdminProfile?       @relation("AdminReviewedEvidence", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@unique([academicMateProfileId, sha256])
  @@index([academicMateProfileId, kind])
  @@index([purgeAfter])
}

model AcademicMateVerification {
  id                    String             @id @default(uuid())
  academicMateProfileId String
  status                VerificationStatus
  notes                 String?
  reviewedByAdminId     String?
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  academicMateProfile AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Cascade)

  reviewedByAdmin AdminProfile? @relation("AdminReviewedAcademicMateVerifications", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([academicMateProfileId, createdAt])
  @@index([status, createdAt])
  @@index([reviewedByAdminId])
}

model MateOffering {
  id                     String                     @id @default(uuid())
  academicMateProfileId  String
  universityId           String
  courseId               String
  title                  String?
  description            String?
  rate                   Decimal                    @db.Decimal(12, 2)
  currency               String                     @default("ZMW")
  sessionDurationMinutes Int                        @default(60)
  status                 MateOfferingStatus         @default(ACTIVE)
  verificationStatus     VerificationStatus         @default(UNVERIFIED)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  academicMateProfile    AcademicMateProfile        @relation(fields: [academicMateProfileId, universityId], references: [id, universityId], onDelete: Cascade)
  university             University                 @relation(fields: [universityId], references: [id], onDelete: Restrict)
  course                 Course                     @relation(fields: [courseId, universityId], references: [id, universityId], onDelete: Restrict)
  topics                 MateOfferingTopic[]
  verifications          MateOfferingVerification[]
  requests               MateRequest[]
  rateType               MateOfferingRateType       @default(PER_SESSION)
  rateDetails            String?
  availability           MateAvailability[]
  sessionGroups          SessionGroup[]

  @@unique([id, universityId])
  @@unique([academicMateProfileId, courseId])
  @@index([universityId, courseId, status])
  @@index([universityId, verificationStatus])
}

enum MateOfferingRateType {
  PER_SESSION
  PER_HOUR
  PER_WEEK
  PER_MONTH
  PER_COURSE
  CUSTOM
  FREE
}

model MateOfferingTopic {
  offeringId String
  topicId    String
  offering   MateOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  topic      CourseTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([offeringId, topicId])
  @@index([topicId])
}

model MateOfferingVerification {
  id                String             @id @default(uuid())
  offeringId        String
  status            VerificationStatus
  notes             String?
  evidenceUrl       String?
  reviewedAt        DateTime?
  reviewedByAdminId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  offering          MateOffering       @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  reviewedByAdmin   AdminProfile?      @relation("AdminVerifiedMateOfferings", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([offeringId, status])
}

model MateAvailability {
  id                    String   @id @default(uuid())
  academicMateProfileId String
  mateOfferingId        String
  day                   Weekday
  startMinute           Int
  endMinute             Int
  timezone              String
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  academicMateProfile AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Cascade)
  mateOffering        MateOffering        @relation(fields: [mateOfferingId], references: [id], onDelete: Cascade)

  @@unique([mateOfferingId, day, startMinute, endMinute])
  @@index([academicMateProfileId, day])
  @@index([mateOfferingId, day])
}

model AcademicMateExperience {
  id                    String              @id @default(uuid())
  academicMateProfileId String
  title                 String
  organisation          String?
  description           String?
  startYear             Int?
  endYear               Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  academicMateProfile   AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Cascade)

  @@index([academicMateProfileId])
}

model AcademicMateQualification {
  id                    String              @id @default(uuid())
  academicMateProfileId String
  name                  String
  issuer                String?
  year                  Int?
  credentialUrl         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  academicMateProfile   AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Cascade)

  @@index([academicMateProfileId])
}

model MateRequest {
  id                            String                    @id @default(uuid())
  studentProfileId              String
  offeringId                    String
  universityId                  String
  message                       String?
  requestedStart                DateTime?
  requestedEnd                  DateTime?
  status                        MateRequestStatus         @default(REQUESTED)
  respondedAt                   DateTime?
  studentSeenAt                 DateTime?
  initialSessionId              String?                   @unique
  arrangementType               TutoringArrangementType   @default(ONE_TIME)
  arrangementStatus             TutoringArrangementStatus @default(PENDING)
  recurrenceEveryWeeks          Int?
  recurrenceWeekday             Weekday?
  recurrenceLocalStartMinute    Int?
  recurrenceTimezone            String?
  recurrenceEndsAt              DateTime?
  arrangementCancelledAt        DateTime?
  arrangementCancelledByUserId  String?
  arrangementCancellationReason String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  studentProfile                StudentProfile            @relation(fields: [studentProfileId, universityId], references: [id, universityId], onDelete: Restrict)
  offering                      MateOffering              @relation(fields: [offeringId, universityId], references: [id, universityId], onDelete: Restrict)
  university                    University                @relation(fields: [universityId], references: [id], onDelete: Restrict)
  arrangementCancelledBy        User?                     @relation("TutoringArrangementCancelledBy", fields: [arrangementCancelledByUserId], references: [id], onDelete: SetNull)
  tutoringSession               TutoringSession?          @relation("InitialSession", fields: [initialSessionId], references: [id], onDelete: Restrict)
  sessions                      TutoringSession[]         @relation("ArrangementSessions")
  conversation                  Conversation?
  payments                      Payment[]

  @@index([universityId, status, createdAt])
  @@index([studentProfileId, status])
  @@index([offeringId, status])
  @@index([arrangementType, arrangementStatus])
  @@index([arrangementCancelledByUserId])
}

model TutoringSession {
  id                    String                     @id @default(uuid())
  arrangementId         String
  scheduledStart        DateTime
  scheduledEnd          DateTime
  meetingLocation       String
  // A venue the student has proposed. The Academic Mate chooses the real venue and can accept or decline this.
  suggestedLocation     String?
  suggestedLocationAt   DateTime?
  status                TutoringSessionStatus      @default(SCHEDULED)
  completedAt           DateTime?
  studentCompletionConfirmedAt DateTime?
  mateCompletionConfirmedAt DateTime?
  completionPromptSentAt DateTime?
  completionDisputedAt DateTime?
  completionDisputedByUserId String?
  completionDisputeReason String?
  completionReviewRequiredAt DateTime?
  // Bundles the sessions that one Academic Mate runs in the same slot, so the mate
  // can confirm attendance and completion once for the whole group.
  groupId               String?
  cancelledAt           DateTime?
  cancellationReason    String?
  // Who cancelled this occurrence (a participant). Null for records made before this was tracked.
  cancelledByUserId     String?
  reminderSentAt        DateTime?
  // Stable identity of this occurrence, retained when its actual time is rescheduled.
  occurrenceSlotStart   DateTime
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  request               MateRequest                @relation("ArrangementSessions", fields: [arrangementId], references: [id], onDelete: Restrict)
  completionDisputedBy  User?                      @relation("SessionCompletionDisputedBy", fields: [completionDisputedByUserId], references: [id], onDelete: SetNull)
  initialForArrangement MateRequest?               @relation("InitialSession")
  group                 SessionGroup?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  cancelledBy           User?                      @relation("SessionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  attendance            Attendance?
  review                Review?
  payments              Payment[]
  rescheduleRequests    SessionRescheduleRequest[]

  @@unique([arrangementId, scheduledStart])
  @@unique([arrangementId, occurrenceSlotStart])
  @@index([scheduledStart, status])
  @@index([status, reminderSentAt, scheduledStart])
  @@index([completionReviewRequiredAt, status])
  @@index([groupId])
  @@index([cancelledByUserId])
}

/// One Academic Mate slot that several students' sessions share. Each student keeps
/// their own session (arrangement, conversation, payment); the group exists so the
/// mate answers once. Unique per offering + exact time window.
model SessionGroup {
  id                              String            @id @default(uuid())
  offeringId                      String
  scheduledStart                  DateTime
  scheduledEnd                    DateTime
  mateAttendancePromptSentAt      DateTime?
  mateCompletionPromptSentAt      DateTime?
  mateAttendanceSubmittedAt       DateTime?
  mateAttendanceSubmittedByUserId String?
  mateCompletionSubmittedAt       DateTime?
  mateCompletionSubmittedByUserId String?
  createdAt                       DateTime          @default(now())
  updatedAt                       DateTime          @updatedAt
  offering                        MateOffering      @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  sessions                        TutoringSession[]

  @@unique([offeringId, scheduledStart, scheduledEnd])
  @@index([scheduledStart])
}

model Attendance {
  id                 String           @id @default(uuid())
  sessionId          String           @unique
  status             AttendanceStatus @default(PENDING)
  studentCheckedInAt DateTime?
  mateConfirmedAt    DateTime?
  studentAttended    Boolean?
  studentRespondedAt DateTime?
  /// How many times the student has changed their answer (capped by MAX_STUDENT_ANSWER_CHANGES).
  studentAnswerChanges Int            @default(0)
  mateConfirmedStudentAttended       Boolean?
  mateRespondedAt    DateTime?
  studentAttendancePromptSentAt DateTime?
  mateAttendancePromptSentAt DateTime?
  disputedAt         DateTime?
  disputeReason      String?
  resolvedAt         DateTime?
  resolvedByAdminId  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  session            TutoringSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resolvedByAdmin    AdminProfile?    @relation("AdminResolvedAttendance", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
}

model SessionRescheduleRequest {
  id               String                  @id @default(uuid())
  sessionId        String
  proposedByUserId String
  respondingUserId String
  proposedStart    DateTime
  proposedEnd      DateTime
  reason           String?
  status           RescheduleRequestStatus @default(PENDING)
  respondedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  session        TutoringSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  proposedBy     User            @relation("RescheduleProposer", fields: [proposedByUserId], references: [id], onDelete: Restrict)
  respondingUser User            @relation("RescheduleResponder", fields: [respondingUserId], references: [id], onDelete: Restrict)

  @@index([sessionId, status])
  @@index([respondingUserId, status])
}

model Review {
  id             String              @id @default(uuid())
  sessionId      String              @unique
  reviewerUserId String
  mateProfileId  String
  rating         Int
  comment        String?
  /// Set when an admin hides the review. Hidden reviews stay on record but are not shown or counted.
  hiddenAt       DateTime?
  hiddenByAdminId String?
  hiddenReason   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  session        TutoringSession     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  reviewerUser   User                @relation("UserReviewsWritten", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  mateProfile    AcademicMateProfile @relation("ReviewsReceived", fields: [mateProfileId], references: [id], onDelete: Restrict)

  @@index([mateProfileId, createdAt])
  @@index([reviewerUserId])
  @@index([hiddenAt])
}

model Conversation {
  id                      String             @id @default(uuid())
  requestId               String             @unique
  studentMessagingEnabled Boolean            @default(true)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  request                 MateRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  reads                   ConversationRead[]
  messages                Message[]
}

model ConversationRead {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser     User         @relation("UserSentMessages", fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderUserId])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_body_trgm_idx")
}

model Notification {
  id         String                 @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  data       Json?
  // Stable identity of the event this notification announces; prevents duplicates.
  dedupeKey  String?                @unique
  readAt     DateTime?
  /// Hidden from the user's list. The row stays so dedupeKey keeps blocking duplicates.
  deletedAt  DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]
  pushDeliveries  PushNotificationDelivery[]

  @@index([userId, readAt, createdAt])
}

model NotificationDelivery {
  id                String              @id @default(uuid())
  notificationId    String
  channel           NotificationChannel
  status            DeliveryStatus      @default(PENDING)
  attemptedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failureReason     String?
  providerReference String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  notification      Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([channel, status])
}

model PushSubscription {
  id         String                     @id @default(uuid())
  userId     String
  fid        String                     @unique
  userAgent  String?
  lastSeenAt DateTime                   @default(now())
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  user       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushNotificationDelivery[]

  @@index([userId, lastSeenAt])
}

model PushNotificationDelivery {
  id                 String            @id @default(uuid())
  notificationId     String
  pushSubscriptionId String?
  status             DeliveryStatus    @default(PENDING)
  attemptCount       Int               @default(0)
  nextAttemptAt      DateTime          @default(now())
  claimedAt          DateTime?
  sentAt             DateTime?
  failureReason      String?
  providerReference  String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  notification       Notification      @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushSubscription   PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([notificationId, pushSubscriptionId])
  @@index([status, nextAttemptAt])
  @@index([pushSubscriptionId, status])
}

model Payment {
  id                    String              @id @default(uuid())
  payerUserId           String
  academicMateProfileId String
  requestId             String?
  sessionId             String?
  provider              PaymentProvider
  providerTransactionId String?             @unique
  externalReference     String              @unique
  amount                Decimal             @db.Decimal(12, 2)
  platformFee           Decimal             @db.Decimal(12, 2)
  tutorAmount           Decimal             @db.Decimal(12, 2)
  currency              String              @default("ZMW")
  status                PaymentStatus       @default(PENDING)
  paidAt                DateTime?
  refundedAt            DateTime?
  failureReason         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  payerUser             User                @relation("UserPaymentsMade", fields: [payerUserId], references: [id], onDelete: Restrict)
  academicMateProfile   AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Restrict)
  request               MateRequest?        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  session               TutoringSession?    @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([payerUserId, createdAt])
  @@index([academicMateProfileId, status, createdAt])
  @@index([status, createdAt])
}

model Payout {
  id                    String              @id @default(uuid())
  academicMateProfileId String
  provider              PaymentProvider
  amount                Decimal             @db.Decimal(12, 2)
  currency              String              @default("ZMW")
  status                PayoutStatus        @default(PENDING)
  externalReference     String              @unique
  providerTransactionId String?             @unique
  paidAt                DateTime?
  failureReason         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  academicMateProfile   AcademicMateProfile @relation(fields: [academicMateProfileId], references: [id], onDelete: Restrict)

  @@index([academicMateProfileId, status, createdAt])
}

model PlatformSettings {
  id                       Int      @id @default(1)
  defaultCurrency          String   @default("ZMW")
  defaultCommissionPercent Decimal  @db.Decimal(5, 2)
  premiumEnabled           Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model SubscriptionPlan {
  id            String               @id @default(uuid())
  name          String               @unique
  description   String?
  price         Decimal              @db.Decimal(12, 2)
  currency      String               @default("ZMW")
  interval      SubscriptionInterval
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  subscriptions UserSubscription[]
}

model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  providerReference  String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([planId, status])
}

model AdminProfile {
  id                                String                     @id @default(uuid())
  userId                            String                     @unique
  role                              AdminRole
  createdAt                         DateTime                   @default(now())
  updatedAt                         DateTime                   @updatedAt
  user                              User                       @relation("UserAdminProfile", fields: [userId], references: [id], onDelete: Cascade)
  universityAccess                  AdminUniversityAccess[]
  verifiedAcademicMates             AcademicMateProfile[]      @relation("AdminVerifiedAcademicMates")
  verifiedMateOfferings             MateOfferingVerification[] @relation("AdminVerifiedMateOfferings")
  resolvedAttendances               Attendance[]               @relation("AdminResolvedAttendance")
  reviewedAcademicMateVerifications AcademicMateVerification[] @relation("AdminReviewedAcademicMateVerifications")
  reviewedEvidence                  AcademicMateEvidence[]     @relation("AdminReviewedEvidence")
  auditLogs                         AdminAuditLog[]            @relation("AdminAuditLogs")
  assignedSupportCases              SupportCase[]              @relation("AdminAssignedCases")
  twoFactor                         AdminTwoFactor?
}

/// Append-only record of sensitive admin actions. Actor name and role are snapshotted so the
/// trail stays meaningful if the admin account is later changed or removed.
model AdminAuditLog {
  id             String        @id @default(uuid())
  adminProfileId String?
  actorUserId    String
  actorName      String
  actorRole      AdminRole
  action         String
  targetType     String
  targetId       String?
  universityId   String?
  summary        String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  adminProfile   AdminProfile? @relation("AdminAuditLogs", fields: [adminProfileId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminProfileId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([universityId, createdAt])
}

model AdminUniversityAccess {
  id             String       @id @default(uuid())
  adminProfileId String
  universityId   String
  createdAt      DateTime     @default(now())
  adminProfile   AdminProfile @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)
  university     University   @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@unique([adminProfileId, universityId])
  @@index([universityId])
}

/// A problem an admin is tracking: who it is about, who owns it, what was decided.
model SupportCase {
  id               String              @id @default(uuid())
  universityId     String?
  subjectUserId    String?
  category         SupportCaseCategory @default(OTHER)
  priority         SupportCasePriority @default(NORMAL)
  status           SupportCaseStatus   @default(OPEN)
  title            String
  description      String
  assignedAdminId  String?
  resolution       String?
  createdByName    String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  resolvedAt       DateTime?
  university       University?         @relation(fields: [universityId], references: [id], onDelete: SetNull)
  subjectUser      User?               @relation("SupportCaseSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  assignedAdmin    AdminProfile?       @relation("AdminAssignedCases", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  notes            SupportCaseNote[]

  @@index([status, priority, createdAt])
  @@index([universityId, status])
  @@index([subjectUserId])
  @@index([assignedAdminId, status])
}

model SupportCaseNote {
  id         String      @id @default(uuid())
  caseId     String
  authorName String
  body       String
  createdAt  DateTime    @default(now())
  supportCase SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

/// An admin's authenticator-app secret for two-step sign-in. The secret is stored encrypted and is not
/// usable until the first code has been entered (confirmedAt).
model AdminTwoFactor {
  id              String            @id @default(uuid())
  adminProfileId  String            @unique
  secretEncrypted String
  confirmedAt     DateTime?
  /// Last accepted 30-second step, so one code cannot be used twice.
  lastUsedStep    Int?
  failedAttempts  Int               @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  adminProfile    AdminProfile      @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)
  backupCodes     AdminBackupCode[]
}

/// One-time recovery codes, kept only as keyed hashes.
model AdminBackupCode {
  id          String         @id @default(uuid())
  twoFactorId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime       @default(now())
  twoFactor   AdminTwoFactor @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  @@unique([twoFactorId, codeHash])
}

/// Marks a sign-in session as having passed two-step verification. An admin session without a row here
/// can do nothing in the admin portal. Deleted with the session.
model AdminSessionMfa {
  sessionId  String   @id
  verifiedAt DateTime @default(now())
  /// TOTP or BACKUP
  method     String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
